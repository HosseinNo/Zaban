# ── پایگاه داده و کش ──────────────────────────────────────────────
POSTGRES_DB=talkora
POSTGRES_USER=talkora
POSTGRES_PASSWORD=                # رمز قوی بگذارید
REDIS_PASSWORD=

# ── اپ ────────────────────────────────────────────────────────────
APP_IMAGE=registry.example.ir/talkora/app:latest
APP_BASE_URL=https://app.talkora.ir
SESSION_SECRET=
# کلید HMAC هش کد یک‌بارمصرف (سند S.8) — هرگز در گیت
OTP_PEPPER=

# ── پیامک: دو ارائه‌دهنده برای failover (بند P.4) ─────────────────
# مهم: خط «خدماتی»، نه تبلیغاتی — وگرنه به دست کسی که تبلیغات را
# لغو کرده اصلاً نمی‌رسد
SMS_PRIMARY=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SERVICE_LINE=
SMS_FALLBACK=mellipayamak
MELLIPAYAMAK_USERNAME=
MELLIPAYAMAK_PASSWORD=
MELLIPAYAMAK_SERVICE_LINE=

# ── درگاه پرداخت ──────────────────────────────────────────────────
PAYMENT_PRIMARY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=https://app.talkora.ir/api/payments/callback/zarinpal

# ── کلاس آنلاین ───────────────────────────────────────────────────
BBB_ENDPOINT=https://bbb.talkora.ir/bigbluebutton/api/
BBB_SHARED_SECRET=                # از bbb-conf --secret
BBB_WEBHOOK_URL=https://app.talkora.ir/api/webhooks/bbb

# Google Meet: حساب سرویس با domain-wide delegation روی دامنهٔ آموزشگاه
GOOGLE_SA_JSON_PATH=/run/secrets/google-sa.json
GOOGLE_IMPERSONATE_SUBJECT=classes@institute.ir

# ── ذخیره‌سازی (سازگار با S3 — آبجکت استوریج آروان) ───────────────
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_BUCKET=talkora-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ir-thr-at1

# ── ضبط ───────────────────────────────────────────────────────────
RECORDING_RETENTION_DAYS=120
RECORDING_UPLOAD_MAX_MBPS=20

# ── بکاپ ──────────────────────────────────────────────────────────
BACKUP_PASSPHRASE=
