<?xml version="1.0" encoding="UTF-8"?>
<!--
  پوشهٔ بارگذاری فقط تصویر می‌دهد، هرگز اجرا نمی‌کند.

  کنار این فایل یک .htaccess هست که همین کار را با php_flag انجام
  می‌دهد — ولی هاست ویندوز است و IIS آن فایل را نمی‌خواند. یعنی تا
  پیش از این، آن محافظ روی سرور زنده هیچ اثری نداشت.

  اگر روزی فایلی با پسوند .php اینجا بنشیند — از راه اشکالی در
  اعتبارسنجی آپلود — بدون این بلوک اجرا می‌شد. بستنِ پسوند در
  requestFiltering از برداشتن handler امن‌تر است: روی هاست اشتراکی
  دست‌بردن به handlers معمولاً اجازه ندارد و خطای ۵۰۰ می‌دهد.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions applyToWebDAV="false">
          <add fileExtension=".php" allowed="false" />
          <add fileExtension=".php5" allowed="false" />
          <add fileExtension=".phtml" allowed="false" />
          <add fileExtension=".asp" allowed="false" />
          <add fileExtension=".aspx" allowed="false" />
          <add fileExtension=".ashx" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- فهرست پوشه هرگز نشان داده نمی‌شود -->
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
